.DS_Store

# Rebuildable Python output must not re-enter source or evidence commits.
__pycache__/
*.py[cod]

# The project-local task memory, migration receipts, records and photos are private.
# Structured memory lives in backup-records/events, never in a sibling archive.
/.codex/
/.local/line-backup/
/state/
/backups/
/config/

# Temporary isolated regression fixtures clean themselves up after testing.
/.line-daily-tests-*/
/.cleanup-audit-tests-*/
