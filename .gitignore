.DS_Store

# Rebuildable Python output must not re-enter source or evidence commits.
__pycache__/
*.py[cod]

# Local machine settings and protected backup data are not public source.
/.codex/
/state/
/backups/
/config/

# Raw local evidence and generated historical runtimes stay on this Mac.
/harness-development/**/private/
/harness-development/**/site-packages/
/harness-development/**/wheels/
/harness-development/**/module-cache*/
/harness-development/**/decoder-module-cache/

# machine-generated bytecode in the test tree (evidence archives keep their own copies)
/tests/automation_verification/__pycache__/

# machine-generated bytecode (top-level tests tree)
/tests/__pycache__/
rev28/.build/
