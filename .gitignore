.DS_Store

# Rebuildable Python output must not re-enter source or evidence commits.
__pycache__/
*.py[cod]

# Local machine settings and protected backup data are not public source.
/.codex/
/.local/line-backup/
/state/
/backups/
/config/

# Temporary isolated regression fixtures clean themselves up after testing.
/.line-daily-tests-*/
/.cleanup-audit-tests-*/
