+def _date_title_ocr_matches(text,identity):
+    """Accept only the complete canonical album date range with a known separator variant."""
+    match=re.fullmatch(r'([0-9]{4})/([0-9]{2})/([0-9]{2})\s*([~～〜])\s*([0-9]{2})/([0-9]{2})',text)
+    if match is None:return False
+    start=identity['start_date'].split('-')
+    end=identity['end_date'].split('-')
+    observed=(match.group(1),match.group(2),match.group(3),match.group(5),match.group(6))
+    expected=(start[0],start[1],start[2],end[1],end[2])
+    return observed==expected
