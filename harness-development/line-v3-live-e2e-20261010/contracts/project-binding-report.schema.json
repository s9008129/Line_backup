{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://codex.local/project-binding-report/v1",
  "oneOf":[{"$ref":"#/$defs/report"},{"$ref":"#/$defs/refusal"}],
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "digest":{"type":"object","additionalProperties":false,"required":["path","bytes","sha256"],"properties":{"path":{"type":"string","minLength":1},"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha"}}},
    "fingerprint":{"type":"object","additionalProperties":false,"required":["start_date","end_date","expected_images"],"properties":{"start_date":{"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"end_date":{"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"expected_images":{"type":"integer","minimum":1}}},
    "request":{"type":"object","additionalProperties":false,"required":["project_root","start_date","end_date","expected_images"],"properties":{"project_root":{"type":"string","pattern":"^/","minLength":2},"start_date":{"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"end_date":{"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"expected_images":{"type":"integer","minimum":1}}},
    "authority":{"type":"object","additionalProperties":false,"required":["project_root","config","state","state_revision","group_name","group_key","app_identifier","backup_root"],"properties":{"project_root":{"type":"string","pattern":"^/","minLength":2},"config":{"$ref":"#/$defs/digest"},"state":{"$ref":"#/$defs/digest"},"state_revision":{"type":"integer","minimum":0},"group_name":{"type":"string","minLength":1},"group_key":{"type":"string","minLength":1},"app_identifier":{"const":"jp.naver.line.mac"},"backup_root":{"type":"string","pattern":"^/","minLength":2}}},
    "target":{"type":"object","additionalProperties":false,"required":["group_key","fingerprint","proposed_destination"],"properties":{"group_key":{"type":"string","minLength":1},"fingerprint":{"$ref":"#/$defs/fingerprint"},"proposed_destination":{"type":"string","pattern":"^/","minLength":2}}},
    "stateFacts":{"type":"object","additionalProperties":false,"required":["current_run_id","current_run_terminal","active_writer_id","context_lock_present","verified_match_run_ids","verified_match_registry_count","unresolved_run_ids","purported_release_run_ids","manual_archive_match","destination_status"],"properties":{"current_run_id":{"type":["string","null"]},"current_run_terminal":{"type":["boolean","null"]},"active_writer_id":{"type":["string","null"]},"context_lock_present":{"type":"boolean"},"verified_match_run_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"verified_match_registry_count":{"type":"integer","minimum":0},"unresolved_run_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"purported_release_run_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"manual_archive_match":{"type":"boolean"},"destination_status":{"enum":["ABSENT","EMPTY","NONEMPTY","UNSAFE","NOT_INSPECTED_VERIFIED","NOT_INSPECTED_BLOCKED","MANUAL_ARCHIVE_RECORDED"]}}},
    "producer":{"type":"object","additionalProperties":false,"required":["source_files","source_sha256","attestation"],"properties":{"source_files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/digest"}},"source_sha256":{"$ref":"#/$defs/sha"},"attestation":{"const":"UNKNOWN"}}},
    "report":{"type":"object","additionalProperties":false,"required":["report_format_version","kind","scope","request","authority","target","decision","reasons","state_facts","producer","expected_total_bytes","expected_content_multiset_sha256","content_expectation","dispatch_authorized","writer_acquired","native_observation_performed","state_modified"],"properties":{
      "report_format_version":{"const":1},"kind":{"const":"REPORT"},"scope":{"const":"PROJECT_PREFLIGHT_READ_ONLY"},"request":{"$ref":"#/$defs/request"},"authority":{"$ref":"#/$defs/authority"},"target":{"$ref":"#/$defs/target"},
      "decision":{"enum":["PROJECT_TARGET_ELIGIBLE_FOR_INSPECTION","SKIP_VERIFIED","SKIP_MANUAL_DIAGNOSTIC","PROJECT_BUSY","BLOCKED_UNRESOLVED","AMBIGUOUS_FINGERPRINT","BLOCKED_DESTINATION"]},"reasons":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"state_facts":{"$ref":"#/$defs/stateFacts"},"producer":{"$ref":"#/$defs/producer"},
      "expected_total_bytes":{"type":"null"},"expected_content_multiset_sha256":{"type":"null"},"content_expectation":{"const":"MEASURE_AFTER_DOWNLOAD_NOT_YET_VERIFIED"},"dispatch_authorized":{"const":false},"writer_acquired":{"const":false},"native_observation_performed":{"const":false},"state_modified":{"const":false}}},
    "refusal":{"type":"object","additionalProperties":false,"required":["report_format_version","kind","scope","error","dispatch_authorized","writer_acquired","native_observation_performed","state_modified"],"properties":{
      "report_format_version":{"const":1},"kind":{"const":"REFUSAL"},"scope":{"const":"PROJECT_PREFLIGHT_READ_ONLY"},
      "error":{"type":"object","additionalProperties":false,"required":["code","message","exit_code"],"properties":{"code":{"enum":["INVALID_INPUT","INVALID_PROJECT_AUTHORITY","INVALID_CONFIG","INVALID_STATE","INVALID_PROJECT_HISTORY","PROJECT_SNAPSHOT_CHANGED","INVALID_PATH","INTERNAL_ERROR"]},"message":{"type":"string","minLength":1},"exit_code":{"enum":[1,2]}}},
      "dispatch_authorized":{"const":false},"writer_acquired":{"const":false},"native_observation_performed":{"const":false},"state_modified":{"const":false}}}
  }
}
