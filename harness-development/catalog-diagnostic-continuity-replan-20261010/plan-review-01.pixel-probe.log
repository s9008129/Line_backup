## Probe B: 8-row display (top-down) bands over y 0..260, all three adjacent pairs

Probe script (fed on stdin; no files written):

import Foundation
import ImageIO
import CoreGraphics

func decode(_ path: String) -> (Int, Int, [UInt8])? {
    guard let src = CGImageSourceCreateWithURL(URL(fileURLWithPath: path) as CFURL, nil),
          let img = CGImageSourceCreateImageAtIndex(src, 0, nil) else { return nil }
    let w = img.width, h = img.height
    guard let cs = CGColorSpace(name: CGColorSpace.sRGB),
          let ctx = CGContext(data: nil, width: w, height: h, bitsPerComponent: 8, bytesPerRow: w*4,
                              space: cs, bitmapInfo: CGImageAlphaInfo.noneSkipLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue) else { return nil }
    ctx.translateBy(x: 0, y: CGFloat(h)); ctx.scaleBy(x: 1, y: -1)
    ctx.draw(img, in: CGRect(x: 0, y: 0, width: w, height: h))
    guard let p = ctx.data else { return nil }
    return (w, h, [UInt8](UnsafeRawBufferPointer(start: p, count: w*h*4)))
}

// buffer rows are vertically flipped vs display; display_y = h-1-buffer_y.
func pairStats(_ a: (Int,Int,[UInt8]), _ b: (Int,Int,[UInt8]), displayY0: Int, displayY1: Int) -> (Int, Int) {
    let (w, h, pa) = a; let (_, _, pb) = b
    var diff = 0; var maxD = 0
    for dy in displayY0..<displayY1 {
        let y = h - 1 - dy
        let row = w*4*y
        for x in 0..<w {
            let o = row + x*4
            let d = max(abs(Int(pa[o])-Int(pb[o])), abs(Int(pa[o+1])-Int(pb[o+1])), abs(Int(pa[o+2])-Int(pb[o+2])))
            if d > 0 { diff += 1; maxD = max(maxD, d) }
        }
    }
    return (diff, maxD)
}

let names = ["scan-000.png","scan-001.png","scan-002.png","scan-003.png"]
var imgs = [String:(Int,Int,[UInt8])]()
for n in names { imgs[n] = decode(n) }
let pairs: [(String,String)] = [("scan-000.png","scan-001.png"),("scan-001.png","scan-002.png"),("scan-002.png","scan-003.png")]
let h = imgs["scan-000.png"]!.1
print("display rows (top-down), width=654. diffPixels / maxDiff per pair")
var dy = 0
while dy + 8 <= 260 {
    var line = String(format: "y %3d..%3d ", dy, dy+8)
    for (n1, n2) in pairs {
        let (d, m) = pairStats(imgs[n1]!, imgs[n2]!, displayY0: dy, displayY1: dy+8)
        line += String(format: "| %5d/%3d ", d, m)
    }
    print(line)
    dy += 8
}

