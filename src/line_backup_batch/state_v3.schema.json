            "y"
          ],
          "type": "object"
        }
      ]
    },
    "reconciliation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "ABORTED_BEFORE_SAVE_ALL_DISPATCH"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "blocking_intent_released": {
                "const": true
              },
              "manual_reconciliation_required": {
                "const": false
              },
              "proof": {
                "$ref": "#/$defs/non_dispatch_proof"
              },
              "trigger_outcome": {
                "const": "NOT_TRIGGERED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "blocking_intent_released": {
                "const": true
              }
            },
            "required": [
              "blocking_intent_released"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "ABORTED_BEFORE_SAVE_ALL_DISPATCH"
              }
            }
          }
        }
      ],
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "blocking_intent_released": {
          "type": "boolean"
        },
