          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "max_wait_seconds": {
          "minimum": 15,
          "type": "integer"
        },
        "poll_interval_seconds": {
          "const": 5
        },
        "recovery_limit": {
          "const": 1
        },
        "schema_version": {
          "const": 2
        },
        "stable_samples": {
          "const": 3
        }
