    "run": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "manual_reconciliation_required": {
                "const": true
              }
            },
            "required": [
              "manual_reconciliation_required"
            ]
          },
          "then": {
            "properties": {
              "reconciliation_reason": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "backup_batch"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "batch_id": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "else": {
            "description": "Legacy historical records only; absence of revision never authorizes a new RC2 run. Optional appended reconciliation does not relabel history.",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "dispatch_state"
                  ]
                },
                {
                  "required": [
                    "dispatch_evidence"
                  ]
                }
              ]
            },
            "properties": {
              "intent": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/intent"
                      },
                      {
                        "properties": {
                          "trigger_outcome": {
                            "enum": [
