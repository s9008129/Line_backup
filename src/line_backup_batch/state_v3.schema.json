        },
        "new_transactions_reserved": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "next_index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "owner_execution_id": {
          "minLength": 1,
          "type": "string"
        },
        "phase": {
          "enum": [
            "CATALOG",
            "ADMITTED",
            "RUNNING",
            "STOPPED",
            "COMPLETED"
          ]
        },
        "policy_version": {
          "const": "batch-policy-1"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "stop_reason": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
