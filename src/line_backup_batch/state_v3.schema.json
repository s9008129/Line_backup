        "batch_id",
        "owner_execution_id",
        "group_key",
        "mode",
        "phase",
        "policy_version",
        "config_sha256",
        "source_sha256",
        "created_at",
        "authorized_new_download_limit",
        "configured_new_download_limit",
        "new_transactions_reserved",
        "manifest_reference",
        "next_index",
        "current_album_run_id",
        "stop_reason"
