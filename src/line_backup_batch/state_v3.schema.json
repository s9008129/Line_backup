                              "CHOOSER_CONFIRMED",
                              "UNKNOWN",
                              "UNEXPECTED_UI"
                            ]
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "intent_state": {
                "enum": [
                  "NONE",
                  "COMMITTED_NOT_DISPATCHED",
                  "DISPATCHED",
                  "TRIGGER_CONFIRMED",
                  "UNKNOWN"
                ]
              }
            }
          },
          "if": {
            "required": [
              "contract_revision"
            ]
          },
          "then": {
            "properties": {
              "intent_state": {
                "enum": [
                  "INTENT_NONE",
                  "INTENT_COMMITTED",
                  "ABORTED_BEFORE_SAVE_ALL_DISPATCH",
                  "SAVE_ALL_DISPATCH_ATTEMPTED",
                  "TRIGGER_CONFIRMED",
                  "TRIGGER_UNKNOWN"
                ]
              }
            },
            "required": [
              "contract_revision",
              "dispatch_state",
              "dispatch_evidence",
              "reconciliations"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "intent_state": {
                "const": "ABORTED_BEFORE_SAVE_ALL_DISPATCH"
              }
            },
            "required": [
              "contract_revision",
              "intent_state"
            ]
          },
          "then": {
            "properties": {
              "intent": {
                "$ref": "#/$defs/intent"
              },
              "reconciliations": {
                "contains": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/reconciliation"
                    },
                    {
                      "properties": {
                        "outcome": {
                          "const": "ABORTED_BEFORE_SAVE_ALL_DISPATCH"
                        }
                      }
                    }
                  ]
                }
              },
              "workflow_outcome": {
                "const": "SAFE_ABORT"
              }
            }
          }
        }
      ],
